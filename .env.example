# Public browser connection values from Supabase > Connect
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only key. Add this in Netlify environment variables; never expose it
# in HTML, assets/app.js, screenshots, chat, or a Git commit.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
