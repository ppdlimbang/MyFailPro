# Used only by the Supabase CLI or GitHub Actions. Never commit real values.
SUPABASE_ACCESS_TOKEN=sbp_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Optional Edge Function origin override. The hosted functions receive their
# Supabase keys automatically; never expose secret keys to browser code.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
